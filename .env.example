# Production Environment Template (e.g. Render / Heroku / Fly.io / Railway / Netlify)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/barcodestudio
SECRET_KEY=generate_a_long_random_string_like_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
STRIPE_API_KEY=sk_live_your_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_stripe_webhook_secret
PORT=8000

# Direct Crypto Wallet Addresses (Where customer payments go)
CRYPTO_USDT_TRC20_WALLET=TBarCodeStudioProPaymentWallet123TRC
CRYPTO_USDT_POLYGON_WALLET=0x71C0aB487A4F4F69B9c41E660d196429f52fB0B1
CRYPTO_BTC_WALLET=bc1qbarcodestudioproexportstokens999btc
CRYPTO_ETH_WALLET=0x71C0aB487A4F4F69B9c41E660d196429f52fB0B1
CRYPTO_SOL_WALLET=BarCodeStudioProTokensPayment11111111111SOL

# Persistent Storage & Backups (Render Disk Mount / AWS EBS / Volume)
RENDER_DISK_PATH=/var/data
PERSISTENT_STORAGE_PATH=/var/data

# Email Delivery Configuration (Password Reset & Verification)
# 1. Resend HTTPS API (Recommended for Render, never blocked on port 443)
RESEND_API_KEY=re_123456789abcdef
EMAIL_FROM="Barcode Studio Pro <onboarding@resend.dev>"

# 2. SendGrid HTTPS API (Alternative HTTPS provider)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# 3. Direct Gmail / Google SMTP (Ports 465 SSL or 587 STARTTLS)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Cloudflare R2 Autonomous Object Storage (Marketplace, Studies & PSDs)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Optional folder prefix filter (leave empty for root of bucket)
R2_PREFIX=
